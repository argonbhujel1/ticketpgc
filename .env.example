# Vercel + Aiven PostgreSQL
FLASK_ENV=production
SECRET_KEY=generate-a-long-random-string

# Aiven connection URI (Dashboard → Service → Connection information)
# Example: postgres://avnadmin:PASS@xxx.aivencloud.com:12345/defaultdb?sslmode=require
# Code auto-converts postgres:// → postgresql://
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

SITE_URL=https://your-app.vercel.app
SESSION_COOKIE_SECURE=True

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow123!

# Email (required — ticket ID + PNG delivery)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=pathrisanischaregoldcup@gmail.com
# Use same Gmail + App Password for MAIL_USERNAME

# Cloudinary (Vercel image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
